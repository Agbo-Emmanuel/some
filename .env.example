# Ahiia Frontend Environment Configuration
VITE_API_URL=https://api.ahiia.ai
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Cloudinary Configuration
# Cloudinary uses UNSIGNED uploads only. Never add VITE_ prefixed secrets —
# Vite embeds all VITE_* variables into the public browser bundle.
VITE_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=Ahiia.AI
